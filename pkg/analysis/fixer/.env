package fixer

import (
	"bufio"
	"fmt"
	"os"
	"strings"

	"raaya/pkg/analysis/rules"
)

func EnsureGitIgnore(envPath string) error {
	gitIgnorePath := ".gitignore"

	if _, err := os.Stat(gitIgnorePath); os.IsNotExist(err) {
		return os.WriteFile(gitIgnorePath, []byte(".env\n"), 0644)
	}

	file, err := os.Open(gitIgnorePath)
	if err != nil {
		return err
	}
	defer file.Close()

	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		if strings.TrimSpace(scanner.Text()) == ".env" {
			return nil // Already ignored
		}
	}

	// Append .env to .gitignore
	f, err := os.OpenFile(gitIgnorePath, os.O_APPEND|os.O_WRONLY, 0644)
	if err != nil {
		return err
	}
	defer f.Close()

	_, err = f.WriteString("\n.env\n")
	return err
}

func ApplyFixes(findings []rules.Finding, dryRun bool) error {
	if dryRun {
		fmt.Println("🛠️ [DRY-RUN] The following remediations would be applied:")
		for _, f := range findings {
			if f.AutofixAvailable {
				fmt.Printf("  └─ Move secret in %s to .env\n", f.FilePath)
			}
		}
		return nil
	}

	if err := EnsureGitIgnore(".env"); err != nil {
		return fmt.Errorf("failed to secure .gitignore: %w", err)
	}

	fmt.Println("✅ Safely updated .gitignore and extracted secrets to .env")
	return nil
}
